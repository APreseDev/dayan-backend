# کپی کنید به .env و مقادیر را عوض کنید
NODE_ENV=production
PORT=3000

# اتصال به PostgreSQL
DATABASE_URL=postgres://dian:CHANGE_ME@localhost:5432/dian

# آدرس نهایی سایت (برای لینک‌ها). مثال: https://dayan.ir
PUBLIC_URL=https://dayan.ir

# پوشه‌ی فایل‌های آپلودشده (باید روی دیسک پایدار باشد)
UPLOAD_DIR=./uploads

# مسیر خروجی بیلد فرانت (npm run build). اگر بگذارید بک‌اند خودش سایت را هم سرو می‌کند
FRONTEND_DIST=../dian-frontend/dist

# پشت پروکسی/لودبالانسر (Nginx، لیارا، ...) باشید true بگذارید تا IP واقعی کاربر خوانده شود
TRUST_PROXY=true

# ساخت خودکار جدول‌ها هنگام راه‌اندازی
AUTO_MIGRATE=true
